.venv/
__pycache__/
*.pyc
*.egg-info/
_deb_extract/
*.deb
.pytest_cache/

# Modelos 3D y archivos pesados del usuario: solo se sube la
# estructura de directorios (un .gitkeep por carpeta), no los assets
modelos/**/*
!modelos/**/
!modelos/**/.gitkeep
texturas/**/*
# packs de fuentes descargados (dafont etc.): licencias varias, no se
# suben — solo los .ttf sueltos de data/fonts/ (DejaVu/Liberation)
pilas3d/data/fonts/*/

# mapas HDR de fondo (Poly Haven, ~7MB c/u) — se bajan aparte,
# el .gitkeep conserva el directorio. Los *.cache son dumps de
# floats regenerables (los crea pilas3d.hdr al primer uso).
pilas3d/data/hdr/*.hdr
pilas3d/data/hdr/*.cache

# Binario de Ollama descargado por los instaladores (MIT, se baja
# aparte; nunca se commitea por peso y licencia de redistribución)
pilas3d/_vendor/

# Juegos generados por el asistente de IA (%ia make_game)
juegos/

# Assets de Minecraft (copyright Mojang - no se pueden publicar)
Texturas Minecraf/
/*.rar
/*.zip
/*.obj
/*.mtl
/*.fbx
/*.gltf
/*.glb
/*.stl
/*.3ds
/*.dae
ejemplos/config-*.json
ejemplos/pose-*.json
ejemplos/anim-*.json

# proyectos scaffolded con pilas3d-init (juegos del usuario)
juego_nuevo/
tests/tmp_test/
