.venv/
__pycache__/
*.pyc
*.egg-info/
_deb_extract/
*.deb
.pytest_cache/

# Modelos 3D y archivos pesados del usuario: solo se sube la
# estructura de directorios (un .gitkeep por carpeta), no los assets
modelos/**/*
!modelos/**/
!modelos/**/.gitkeep
texturas/**/*
# packs de fuentes descargados (dafont etc.): licencias varias, no se
# suben — solo los .ttf sueltos de data/fonts/ (DejaVu/Liberation)
pilas3d/data/fonts/*/

# Binario de Ollama descargado por los instaladores (MIT, se baja
# aparte; nunca se commitea por peso y licencia de redistribución)
pilas3d/_vendor/

# Juegos generados por el asistente de IA (%ia make_game)
juegos/

# Assets de Minecraft (copyright Mojang - no se pueden publicar)
Texturas Minecraf/
/*.rar
/*.zip
/*.obj
/*.mtl
/*.fbx
/*.gltf
/*.glb
/*.stl
/*.3ds
/*.dae
ejemplos/config-*.json
ejemplos/pose-*.json
ejemplos/anim-*.json
